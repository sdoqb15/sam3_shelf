    "safe_gt_overlap": 0.02,
    "protected_min_score": 0.9,
    "rank_weight": 1.0,
    "error_rank_weight": 0.5,
    "negative_weight": 1.0,
    "complete_anchor_weight": 2.0,
    "rear_anchor_weight": 2.0,
    "unknown_anchor_weight": 0.5,
    "maximum_rear_mean_score_drop": 0.02,
    "maximum_rear_score_drop": 0.1
